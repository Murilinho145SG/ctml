<headers><application name="Selector matrix parity" desktop width="640" height="360" /><stylesheet href="style.css" /></headers>
<body>
    <main>
        <p class="class-match">A</p>
        <p id="id-match">B</p>
        <p class="descendant">C</p>
        <p class="child">D</p>
        <p class="group-a">E</p>
        <p class="group-b">F</p>
        <p class="compound special">G</p>
    </main>
</body>
