<headers>
    <application name="Text decoration thickness parity" desktop width="640" height="360" />
    <stylesheet href="style.css" />
</headers>

<body>
    <p class="auto">underline thickness auto</p>
    <p class="from-font">underline thickness from font</p>
    <p class="zero">underline thickness zero</p>
    <p class="one">underline thickness one pixel</p>
    <p class="two">underline thickness two pixels</p>
    <p class="half">underline thickness fifty percent</p>
</body>
